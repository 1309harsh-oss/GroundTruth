# GroundTruth Environment Configuration Template
PROJECT_NAME="GroundTruth API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & Tokens
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (SQLite for local zero-dependency development, PostgreSQL/PostGIS for production)
DATABASE_URL="sqlite:///./data/groundtruth.db"
# DATABASE_URL="postgresql://groundtruth_user:securepassword@localhost:5432/groundtruth_db"

# Object Storage Configuration
STORAGE_LOCAL_ROOT="./data/storage"
MAX_UPLOAD_SIZE_BYTES=26214400

# Redis / Job Queue (Production)
REDIS_URL="redis://localhost:6379/0"
